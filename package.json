{
  "name": "rekogai-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node ./bin/www.js",
    "dev": "nodemon --legacy-watch ./bin/www.js",
    "dev:redis": "docker-compose up -d redis && npm run dev",
    "redis:start": "docker-compose up -d redis",
    "redis:stop": "docker-compose down",
    "redis:logs": "docker-compose logs -f redis",
    "redis:cli": "docker-compose exec redis redis-cli",
    "test": "jest --coverage --passWithNoTests",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.js || echo 'ESLint not configured'",
    "lint:fix": "eslint src/**/*.js --fix || echo 'ESLint not configured'"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.731.0",
    "@aws-sdk/client-dynamodb": "^3.731.1",
    "@aws-sdk/client-rekognition": "^3.734.0",
    "@aws-sdk/client-s3": "^3.723.0",
    "@aws-sdk/s3-request-presigner": "^3.735.0",
    "aws-jwt-verify": "^5.0.0",
    "aws-sdk": "^2.1692.0",
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.3",
    "bullmq": "^4.15.0",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "express": "~4.16.1",
    "http-errors": "~1.6.3",
    "ioredis": "^5.3.0",
    "pg": "^8.13.3",
    "pg-hstore": "^2.3.4",
    "redis": "^5.8.0",
    "sequelize": "^6.37.5",
    "sharp": "^0.33.5",
    "socket.io": "^4.7.0",
    "uuid": "^11.0.4",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "debug": "~2.6.9",
    "dotenv": "^16.4.7",
    "eslint": "^8.52.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.4.2",
    "supertest": "^6.3.4"
  }
}
